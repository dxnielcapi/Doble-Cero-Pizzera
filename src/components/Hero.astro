---
/**
 * Hero — Doble Cero
 *
 * Portada del menú, montada sobre la referencia de dirección de arte:
 *
 *   1. Titular gigante en rojo, con un párrafo centrado debajo.
 *   2. Una pieza principal a lo ancho.
 *   3. Un bloque de recomendaciones con tres piezas en fila.
 *
 * Todo entra con el revelado por scroll del layout (`data-aparece`): primero el
 * titular, luego el párrafo y por último las fotos, que suben un punto más que
 * el texto. Las tres de abajo van escalonadas de izquierda a derecha.
 *
 * La foto cubre el hero entero —hasta el pie de las tres piezas—; lo que venga
 * después de la sección ya es el crema plano de la página. El corte no está
 * medido a mano: la foto es el fondo de `.hero`, así que termina exactamente
 * donde termina la sección.
 */

import Estampas from './Estampas.astro';

/**
 * Las fotos se sirven desde `public/Hero/` en WebP y en varios anchos, que
 * genera `npm run assets:hero` a partir de los originales de `src/assets/hero/`
 * —los originales no se publican—. Con `srcset` cada visitante se descarga solo
 * la variante que su pantalla justifica: el móvil no carga la de escritorio.
 *
 * Si tocas los anchos, tócalos en los dos sitios: aquí y en el script.
 */
const juego = (nombre, anchos) =>
  anchos.map((ancho) => `/Hero/${nombre}-${ancho}.webp ${ancho}w`).join(', ');

/**
 * La pieza de arriba es ambiente y no lleva nada escrito, así que se recorta a
 * la franja apaisada sin perder información. Ese recorte ya viene hecho: el
 * original es vertical (2:3) y el script lo sirve en 5:2, la proporción de la
 * caja, para no mandar los dos tercios de foto que el navegador descartaría.
 *
 * O sea que el encuadre vertical ya no se decide aquí. Si quieres subir o bajar
 * la rebanada, se toca `foco` en `scripts/prepare-hero-assets.mjs` y se vuelven
 * a generar las variantes.
 */
const PRINCIPAL = {
  src: '/Hero/dob_1-1400.webp',
  srcset: juego('dob_1', [800, 1400, 2100, 2800]),
  /* Ocupa el ancho útil entero: 104.5rem con el tope puesto (110rem menos los
     dos márgenes de 2.75rem), y todo el hueco disponible por debajo. */
  sizes: '(width >= 110rem) 104.5rem, (width >= 48rem) calc(100vw - 5.5rem), calc(100vw - 2rem)',
  /* Ya recortada: la proporción de origen es la de la caja. */
  ancho: 3000,
  alto: 1200,
  alt: 'Un cocinero emplata sobre la barra de la pizzería.',
};

/**
 * Las tres de abajo traen el nombre del plato y los ingredientes rotulados
 * dentro de la propia imagen y pegados a los bordes —el título de `dob_2` va a
 * un 7% del borde superior; el de `dob_4`, casi en el inferior—. Por eso la
 * caja respeta su proporción de origen (4:5) en vez de recortar: cualquier
 * recorte se come los rótulos. Si tocas `--pieza`, cuenta con ello.
 */
const RECOMENDACIONES = [
  {
    nombre: 'dob_2',
    alt: 'Pizza Quattro Stagioni: jamón de pavo ahumado, mozzarella fresco, aceitunas negras, pimiento morrón y champiñones.',
  },
  {
    nombre: 'dob_3',
    alt: 'Pizza Piña Sunset: cebolla morada, tocino, mozzarella fresco y piña ahumada.',
  },
  {
    nombre: 'dob_4',
    alt: 'Pizza Ahumada Suprema: parmesano, cebolla caramelizada y miel con habanero, tocino y mozzarella fresco.',
  },
].map((foto) => ({
  ...foto,
  src: `/Hero/${foto.nombre}-1080.webp`,
  srcset: juego(foto.nombre, [600, 820, 1080]),
  /* Tres columnas del ancho útil hasta el pliegue; a partir de ahí se apilan y
     cada una pasa a ocupar la ventana menos los márgenes. */
  sizes: '(width >= 110rem) 33rem, (width >= 48rem) 31vw, calc(100vw - 2rem)',
  ancho: 1080,
  alto: 1350,
}));

/**
 * El párrafo va cortado a mano, un elemento por línea. La referencia no reparte
 * el texto en líneas parejas: la primera cruza entera y las tres siguientes
 * quedan cortas y desiguales, y ese desnivel es parte del dibujo. Por debajo de
 * `64rem` los cortes se apagan (ver la hoja de estilo) y el texto fluye solo.
 */
const RESENA = [
  'La pizza napolitana, de masa tierna y delgada pero bordes altos, es la versión propia de la cocina napolitana de la pizza redonda. El término',
  'pizza napoletana, por su importancia histórica o regional, se emplea en algunas zonas como sinónimo',
  'de pizza tonda (‘pizza redonda’). Bajo la denominación pizza napoletana verace artigianale (‘pizza napolitana auténtica',
  'artesanal’) está reconocida como producto agroalimentario tradicional italiano.',
];
---

<section class="hero">
  <Estampas />

  <div class="hero__cabecera">
    <div class="hero__ancho">
      <h1 class="hero__titular" data-aparece>Menu</h1>
      <p class="hero__resena" data-aparece set:html={RESENA.join('<br />')} />

      <figure class="hero__pieza hero__pieza--principal" data-aparece>
        <img
          class="hero__imagen"
          src={PRINCIPAL.src}
          srcset={PRINCIPAL.srcset}
          sizes={PRINCIPAL.sizes}
          alt={PRINCIPAL.alt}
          width={PRINCIPAL.ancho}
          height={PRINCIPAL.alto}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </div>

  <div class="hero__recomendaciones">
    <div class="hero__ancho">
      <h2 class="hero__rotulo" data-aparece>Nuestras recomendaciones</h2>

      <ul class="hero__fila">
        {
          RECOMENDACIONES.map(({ src, srcset, sizes, alt, ancho, alto }, i) => (
            <li class="hero__pieza" data-aparece style={`--retardo: ${(i + 1) * 110}ms`}>
              <img
                class="hero__imagen"
                src={src}
                srcset={srcset}
                sizes={sizes}
                alt={alt}
                width={ancho}
                height={alto}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------------
     Mandos del hero. Todo lo que se retoca a ojo vive aquí.
  --------------------------------------------------------------------- */
  .hero {
    --ancho-util: 110rem; /* ancho máximo del contenido */
    --margen: clamp(1rem, 2.4vw, 2.75rem); /* aire a los lados */
    --hueco: clamp(1.5rem, 2.6vw, 3rem); /* separación entre las tres piezas */

    --foco: center; /* encuadre de la foto de fondo */

    --titular: clamp(4rem, 19vw, 21rem);
    --resena: clamp(0.8125rem, 1.15vw, 1.1875rem);
    --resena-ancho: min(88rem, 100%); /* debe dar para la línea larga entera */
    --rotulo: clamp(1.5rem, 3.4vw, 3.5rem);

    /* Espacio entre líneas. Cuanto más bajo, más apretado. */
    --interlinea-titular: 0.82;
    --interlinea-resena: 1.3;
    --interlinea-rotulo: 1.05;

    --pieza-principal: 5 / 2; /* proporción de la franja de arriba */
    /* El encuadre de dob_1 lo aplica el script al recortar, no esta capa: la
       foto ya llega en 5:2 y `cover` no tiene nada que recortar. Se queda como
       red de seguridad por si algún día `--pieza-principal` deja de coincidir
       con la proporción que genera el script. */
    --encuadre-principal: center;
    --pieza: 4 / 5; /* la de origen de las tres: recortar borra sus rótulos */
    --encuadre: center;

    /* Ancla de las estampas, que van en una capa absoluta. `clip` y no
       `hidden`: recorta lo que asoma por los lados sin crear un contenedor de
       scroll, que rompería cualquier `sticky` que venga después. */
    position: relative;
    overflow-x: clip;

    /* La foto va sin tratar, como en la referencia. Se parte de la variante
       ligera: el fondo va a sangre, así que quien manda aquí es el ancho de la
       ventana y no la caja de contenido. La grande entra más abajo.

       Aquí va el WebP, que lo entiende todo el mundo; el AVIF entra más abajo,
       en su propio `@supports`. */
    background-image: url('/Hero/Background-900.webp');
    background-position: var(--foco);
    background-size: cover;
  }

  /* Caja común: fija el ancho útil y los márgenes laterales de todo el hero,
     para que la pieza principal y las recomendaciones compartan eje. */
  .hero__ancho {
    margin-inline: auto;
    max-width: var(--ancho-util);
    padding-inline: var(--margen);
  }

  /* Sin `min-height`: la referencia es un cartel continuo, y forzar una
     pantalla completa aquí abría un socavón de foto entre la pieza principal y
     las recomendaciones. La altura la marca el contenido. */
  .hero__cabecera {
    /* La barra es fija y flota encima: el aire de la referencia se cuenta a
       partir de su borde inferior, no del borde de la pantalla. */
    padding-block: calc(var(--altura-barra) + clamp(2rem, 5vh, 4.5rem)) 0;
  }

  .hero__titular {
    margin: 0;
    color: var(--color-rojo);
    font-family: var(--font-display);
    font-size: var(--titular);
    font-weight: 900;
    line-height: var(--interlinea-titular);
    letter-spacing: -0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Escalonado corto: el titular abre y el párrafo lo sigue. Simultáneos se
     leen como un solo bloque que parpadea. */
  .hero__resena {
    --retardo: 140ms;

    margin: clamp(0.75rem, 1.6vw, 1.5rem) auto 0;
    max-width: var(--resena-ancho);
    color: var(--color-rojo);
    font-size: var(--resena);
    font-weight: 600;
    line-height: var(--interlinea-resena);
    text-align: center;
    text-wrap: pretty;
  }

  /* La caja fija la proporción y recorta; la imagen la rellena. */
  .hero__pieza {
    /* Suben un poco más que el texto y llegan mínimamente pasadas de tamaño,
       para que la foto se asiente en vez de encenderse de golpe. El escalón es
       pequeño a propósito: a partir de ahí ya no es un revelado, es un zoom. */
    --entrada: translateY(1.75rem) scale(1.02);

    overflow: hidden;
    margin: 0;
    aspect-ratio: var(--pieza);
  }

  .hero__pieza--principal {
    /* Cierra la entrada de la cabecera: titular, párrafo y por último la foto. */
    --retardo: 240ms;

    margin-top: clamp(1.75rem, 4vw, 3.5rem);
    aspect-ratio: var(--pieza-principal);
  }

  .hero__imagen {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--encuadre);
  }

  .hero__pieza--principal .hero__imagen {
    object-position: var(--encuadre-principal);
  }

  .hero__recomendaciones {
    padding-block: clamp(2rem, 4.5vw, 3.75rem) clamp(3rem, 7vw, 6rem);
  }

  /* Blanco sobre la foto, como en la referencia. */
  .hero__rotulo {
    margin: 0 0 clamp(1.25rem, 2.6vw, 2.5rem);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--rotulo);
    font-weight: 800;
    line-height: var(--interlinea-rotulo);
    letter-spacing: -0.01em;
    text-align: center;
  }

  .hero__fila {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--hueco);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Por debajo de este ancho la de 900 px ya cubre incluso pantallas 2x, y son
     160 kB menos en el móvil, que es donde más duelen. */
  @media (width >= 56rem) {
    .hero {
      background-image: url('/Hero/Background-1800.webp');
    }
  }

  /* El fondo en AVIF: un tercio del peso del WebP y algo más fiel al original.
     Va en un `@supports` y no como segunda declaración detrás del WebP porque
     el minificador da por soportado `image-set()` con `type()` en todo el
     abanico de destino y se come la línea de reserva —y entonces los que
     entienden `image-set()` pero no `type()`, Safari 16 entre ellos, se
     quedarían sin fondo. Un bloque `@supports` no lo puede plegar.

     Al ir después, gana por orden a las dos reglas de arriba; dentro, la del
     media query gana a la de base igual que fuera. */
  @supports (background-image: image-set(url('/Hero/Background-900.avif') type('image/avif'))) {
    .hero {
      background-image: image-set(url('/Hero/Background-900.avif') type('image/avif'));
    }

    @media (width >= 56rem) {
      .hero {
        background-image: image-set(url('/Hero/Background-1800.avif') type('image/avif'));
      }
    }
  }

  /* Los cortes del párrafo están calculados para el ancho de escritorio; más
     abajo dejarían líneas sueltas, así que se apagan y el texto fluye solo. */
  @media (width < 64rem) {
    .hero__resena br {
      display: none;
    }
  }

  /* A tres columnas los rótulos de las fotos se vuelven ilegibles: por debajo
     del pliegue se apilan. La proporción no cambia —sigue siendo la de origen—
     para no recortarlos. */
  @media (width < 48rem) {
    .hero__fila {
      grid-template-columns: 1fr;
    }
  }
</style>
