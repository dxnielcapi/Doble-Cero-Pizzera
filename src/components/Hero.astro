---
/**
 * Hero — Doble Cero
 *
 * Portada del menú, montada sobre la referencia de dirección de arte:
 *
 *   1. Titular gigante en rojo, con un párrafo centrado debajo.
 *   2. Una pieza principal a lo ancho.
 *   3. Un bloque de recomendaciones con tres piezas en fila.
 *
 * La foto cubre el hero entero —hasta el pie de las tres piezas—; lo que venga
 * después de la sección ya es el crema plano de la página. El corte no está
 * medido a mano: la foto es el fondo de `.hero`, así que termina exactamente
 * donde termina la sección.
 */

import Estampas from './Estampas.astro';

/**
 * La pieza de arriba es ambiente y no lleva nada escrito, así que puede
 * recortarse a la franja apaisada sin perder información. Es vertical (2:3) en
 * una caja de 5:2, o sea que solo se ve una rebanada estrecha:
 * `--encuadre-principal` elige cuál.
 */
const PRINCIPAL = {
  src: '/Hero/dob_1.jpg',
  ancho: 3000,
  alto: 4500,
  nombre: 'Doble Cero Pizzerias',
  alt: 'Un cocinero emplata sobre la barra de la pizzería.',
};

/**
 * Las tres de abajo traen el nombre del plato y los ingredientes rotulados
 * dentro de la propia imagen y pegados a los bordes —el título de `dob_2` va a
 * un 7% del borde superior; el de `dob_4`, casi en el inferior—. Por eso la
 * caja respeta su proporción de origen (4:5) en vez de recortar: cualquier
 * recorte se come los rótulos. Si tocas `--pieza`, cuenta con ello.
 */
const RECOMENDACIONES = [
  {
    src: '/Hero/dob_2.jpg',
    nombre: 'Pizza Quattro Stagioni',
    alt: 'Pizza recién sacada del horno de leña, con jamón de pavo ahumado, mozzarella fresco, aceitunas negras, pimiento morrón y champiñones.',
  },
  {
    src: '/Hero/dob_3.jpg',
    nombre: 'Pizza Piña Sunset',
    alt: 'Primer plano de una pizza con cebolla morada, tocino, mozzarella fresco y piña ahumada.',
  },
  {
    src: '/Hero/dob_4.jpg',
    nombre: 'Pizza Ahumada Suprema',
    alt: 'Pizza dentro del horno, con parmesano, cebolla caramelizada, miel con habanero, tocino y mozzarella fresco.',
  },
].map((foto) => ({ ...foto, ancho: 1080, alto: 1350 }));

/**
 * El párrafo va cortado a mano, un elemento por línea. La referencia no reparte
 * el texto en líneas parejas: la primera cruza entera y las tres siguientes
 * quedan cortas y desiguales, y ese desnivel es parte del dibujo. Por debajo de
 * `64rem` los cortes se apagan (ver la hoja de estilo) y el texto fluye solo.
 */
const RESENA = [
  'La pizza napolitana, de masa tierna y delgada pero bordes altos, es la versión propia de la cocina napolitana de la pizza redonda. El término',
  'pizza napoletana, por su importancia histórica o regional, se emplea en algunas zonas como sinónimo',
  'de pizza tonda (‘pizza redonda’). Bajo la denominación pizza napoletana verace artigianale (‘pizza napolitana auténtica',
  'artesanal’) está reconocida como producto agroalimentario tradicional italiano.',
];
---

<section class="hero">
  <Estampas />

  <div class="hero__cabecera">
    <div class="hero__ancho">
      <h1 class="hero__titular" data-aparece>Menu</h1>
      <p class="hero__resena" data-aparece set:html={RESENA.join('<br />')} />

      <figure class="hero__pieza hero__pieza--principal">
        <img
          class="hero__imagen"
          src={PRINCIPAL.src}
          alt={PRINCIPAL.alt}
          width={PRINCIPAL.ancho}
          height={PRINCIPAL.alto}
          decoding="async"
        />
        <figcaption class="hero__nombre">{PRINCIPAL.nombre}</figcaption>
      </figure>
    </div>
  </div>

  <div class="hero__recomendaciones">
    <div class="hero__ancho">
      <h2 class="hero__rotulo" data-aparece>Nuestras recomendaciones</h2>

      <ul class="hero__fila">
        {
          RECOMENDACIONES.map(({ src, nombre, alt, ancho, alto }) => (
            <li>
              <figure class="hero__pieza">
                <img
                  class="hero__imagen"
                  src={src}
                  alt={alt}
                  width={ancho}
                  height={alto}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="hero__nombre">{nombre}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------------
     Mandos del hero. Todo lo que se retoca a ojo vive aquí.
  --------------------------------------------------------------------- */
  .hero {
    --ancho-util: 110rem; /* ancho máximo del contenido */
    --margen: clamp(1rem, 2.4vw, 2.75rem); /* aire a los lados */
    --hueco: clamp(1.5rem, 2.6vw, 3rem); /* separación entre las tres piezas */

    --foco: center; /* encuadre de la foto de fondo */

    --titular: clamp(4rem, 19vw, 21rem);
    --resena: clamp(0.8125rem, 1.15vw, 1.1875rem);
    --resena-ancho: min(88rem, 100%); /* debe dar para la línea larga entera */
    --rotulo: clamp(1.5rem, 3.4vw, 3.5rem);

    /* Rótulo manuscrito del hover: tamaño, acercamiento de la foto y hasta
       dónde tiñe la sombra del pie. */
    --nombre: clamp(0.95rem, 1.35vw, 1.375rem);
    --nombre-principal: clamp(1.125rem, 1.8vw, 1.875rem);
    --zoom: 1.06;
    --velo: 0.5;

    /* Espacio entre líneas. Cuanto más bajo, más apretado. */
    --interlinea-titular: 0.82;
    --interlinea-resena: 1.3;
    --interlinea-rotulo: 1.05;

    --pieza-principal: 5 / 2; /* proporción de la franja de arriba */
    --encuadre-principal: center 45%; /* qué rebanada de dob_1 se ve */
    --pieza: 4 / 5; /* la de origen de las tres: recortar borra sus rótulos */
    --encuadre: center;

    /* Ancla de las estampas, que van en una capa absoluta. `clip` y no
       `hidden`: recorta lo que asoma por los lados sin crear un contenedor de
       scroll, que rompería cualquier `sticky` que venga después. */
    position: relative;
    overflow-x: clip;

    /* La foto va sin tratar, como en la referencia. */
    background-image: url('/Hero/Background.jpg');
    background-position: var(--foco);
    background-size: cover;
  }

  /* Caja común: fija el ancho útil y los márgenes laterales de todo el hero,
     para que la pieza principal y las recomendaciones compartan eje. */
  .hero__ancho {
    margin-inline: auto;
    max-width: var(--ancho-util);
    padding-inline: var(--margen);
  }

  /* Sin `min-height`: la referencia es un cartel continuo, y forzar una
     pantalla completa aquí abría un socavón de foto entre la pieza principal y
     las recomendaciones. La altura la marca el contenido. */
  .hero__cabecera {
    /* La barra es fija y flota encima: el aire de la referencia se cuenta a
       partir de su borde inferior, no del borde de la pantalla. */
    padding-block: calc(var(--altura-barra) + clamp(2rem, 5vh, 4.5rem)) 0;
  }

  .hero__titular {
    margin: 0;
    color: var(--color-rojo);
    font-family: var(--font-display);
    font-size: var(--titular);
    font-weight: 900;
    line-height: var(--interlinea-titular);
    letter-spacing: -0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Escalonado corto: el titular abre y el párrafo lo sigue. Simultáneos se
     leen como un solo bloque que parpadea. */
  .hero__resena {
    --retardo: 140ms;

    margin: clamp(0.75rem, 1.6vw, 1.5rem) auto 0;
    max-width: var(--resena-ancho);
    color: var(--color-rojo);
    font-size: var(--resena);
    font-weight: 600;
    line-height: var(--interlinea-resena);
    text-align: center;
    text-wrap: pretty;
  }

  /* La caja fija la proporción y recorta; la imagen la rellena. `relative` para
     que el rótulo del hover se cuelgue de ella. */
  .hero__pieza {
    position: relative;
    overflow: hidden;
    margin: 0;
    aspect-ratio: var(--pieza);
  }

  /* Nombre del plato, al pie. En vez de teñir la foto entera, la sombra es un
     degradado que solo sube desde abajo: la imagen se queda a la vista y el
     manuscrito blanco conserva contraste justo donde se apoya. */
  .hero__nombre {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.75em 1em 1em;

    background-image: linear-gradient(to top, rgb(0 0 0 / var(--velo)), transparent);
    color: #fff;
    font-family: var(--font-mano);
    font-size: var(--nombre);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;

    opacity: 0;
    /* Sube un poco al entrar; acompaña al acercamiento sin competir con él. */
    transform: translateY(0.5rem);
    transition:
      opacity 320ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero__pieza--principal .hero__nombre {
    font-size: var(--nombre-principal);
  }

  /* Solo donde hay puntero de verdad. En táctil el hover no existe: se quedaría
     enganchado tras el toque, tapando la foto hasta que tocaras otra cosa. */
  @media (hover: hover) and (pointer: fine) {
    .hero__pieza:hover .hero__imagen {
      transform: scale(var(--zoom));
    }

    .hero__pieza:hover .hero__nombre {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__nombre,
    .hero__imagen {
      transition: none;
    }

    .hero__nombre {
      transform: none;
    }

    /* Quien pide menos movimiento no quiere que la foto se le mueva debajo. */
    .hero__pieza:hover .hero__imagen {
      transform: none;
    }
  }

  .hero__pieza--principal {
    margin-top: clamp(1.75rem, 4vw, 3.5rem);
    aspect-ratio: var(--pieza-principal);
  }

  /* El acercamiento del hover lo recorta el `overflow: hidden` de la caja: la
     foto crece por dentro y el layout no se mueve. */
  .hero__imagen {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--encuadre);
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero__pieza--principal .hero__imagen {
    object-position: var(--encuadre-principal);
  }

  .hero__recomendaciones {
    padding-block: clamp(2rem, 4.5vw, 3.75rem) clamp(3rem, 7vw, 6rem);
  }

  /* Blanco sobre la foto, como en la referencia. */
  .hero__rotulo {
    margin: 0 0 clamp(1.25rem, 2.6vw, 2.5rem);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--rotulo);
    font-weight: 800;
    line-height: var(--interlinea-rotulo);
    letter-spacing: -0.01em;
    text-align: center;
  }

  .hero__fila {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--hueco);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Los cortes del párrafo están calculados para el ancho de escritorio; más
     abajo dejarían líneas sueltas, así que se apagan y el texto fluye solo. */
  @media (width < 64rem) {
    .hero__resena br {
      display: none;
    }
  }

  /* A tres columnas los rótulos de las fotos se vuelven ilegibles: por debajo
     del pliegue se apilan. La proporción no cambia —sigue siendo la de origen—
     para no recortarlos. */
  @media (width < 48rem) {
    .hero__fila {
      grid-template-columns: 1fr;
    }
  }
</style>
