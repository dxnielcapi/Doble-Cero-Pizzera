---
import '../styles/global.css';
import Intro from '../components/Intro.astro';
import Barra from '../components/Barra.astro';
import Pie from '../components/Pie.astro';

interface Props {
	title?: string;
	description?: string;
	/** La cortina de entrada solo tiene sentido en la portada. */
	intro?: boolean;
}

const {
	title = 'Doble Cero — Pizzería',
	description = 'Menú de la pizzería Doble Cero.',
	intro = false,
} = Astro.props;

// La cortina no puede empezar a moverse hasta tener sus recortes: se piden
// junto al HTML para acortar todo lo posible el crema en blanco del principio.
const PIEZAS = Array.from({ length: 10 }, (_, i) => `/assets_intro/derived/pizza_${i + 1}.webp`);
---

<!doctype html>
<html lang="es" class={intro ? 'esta-cargando intro-vacio' : undefined}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f6e9c8" />
		<title>{title}</title>

		{/* En línea y en el `<head>` a propósito: marca la raíz antes del primer
		pintado, así el contenido con `data-aparece` nunca llega a verse antes de
		esconderse. Un script diferido llegaría tarde y se vería el parpadeo. */}
		<script is:inline>
			document.documentElement.classList.add('con-aparicion');

			// Al recargar, el navegador devuelve la página a donde estaba. Aquí eso
			// significa reaparecer a media página con la cortina echada y el hero
			// ya revelado a puerta cerrada, así que se apaga: cada carga empieza
			// arriba. Va aquí y no en un script diferido porque la restauración
			// ocurre antes de que ese llegue a ejecutarse.
			//
			// Un `#ancla` en la URL se sigue respetando: no es memoria del
			// navegador, es una intención de quien abrió el enlace.
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
		</script>

		{/* Coolvetica va autoalojada (ver `global.css`): se acabaron los viajes a
		Google Fonts. Se precarga porque la usa el titular del hero, que es lo
		primero que aparece al retirarse la cortina. `crossorigin` es obligatorio
		en el preload de fuentes aunque sean del mismo origen; sin él el navegador
		la descarga dos veces. */}
		<link rel="preload" as="font" type="font/woff2" href="/fonts/coolvetica.woff2" crossorigin />

		{
			intro &&
				PIEZAS.map((href) => (
					<link rel="preload" as="image" href={href} fetchpriority="high" />
				))
		}
	</head>
	<body class="min-h-screen bg-crema text-tinta antialiased">
		{intro && <Intro />}
		<Barra />
		<slot />
		<Pie />

		<script>
			// Revelado por scroll. Solo toca el atributo: el aspecto lo decide el
			// CSS (ver `global.css`), y cada componente ajusta su entrada con
			// `--entrada` / `--reposo`.
			const raiz = document.documentElement;
			const objetivos = [...document.querySelectorAll<HTMLElement>('[data-aparece]')];
			const marcar = (el: HTMLElement) => el.setAttribute('data-aparece', 'dentro');

			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				objetivos.forEach(marcar);
			} else {
				// Una sola vez por elemento: al volver a subir no se rebobina, que
				// releer la página con todo parpadeando cansa.
				const mirador = new IntersectionObserver(
					(entradas) => {
						for (const entrada of entradas) {
							if (!entrada.isIntersecting) continue;
							marcar(entrada.target as HTMLElement);
							mirador.unobserve(entrada.target);
						}
					},
					// Basta con que el borde de arriba cruce la línea: el revelado
					// arranca cuando el elemento asoma, no cuando ya está medio dentro.
					// Un `threshold` alto castigaba a lo que mide más que la pantalla
					// —las fotos del hero, que en móvil pasan de una pantalla de alto—:
					// exigirles un 15% de su propia altura las dejaba en blanco hasta
					// casi el final del scroll. La línea se queda un poco por encima del
					// borde inferior para no revelar nada aún fuera de campo.
					{ rootMargin: '0px 0px -8% 0px', threshold: 0 },
				);

				// Por debajo de esa línea queda una franja muerta al final del
				// documento: lo que caiga ahí con la página ya al fondo no llega a
				// cruzarla nunca y se quedaría invisible. Le pasaba al último topping
				// de la carta, que es el último elemento de la página y solo tiene el
				// margen inferior de la sección por debajo. Al tocar fondo se revela lo
				// que falte.
				const revelarRezagados = () => {
					const fondo = document.documentElement.scrollHeight - window.innerHeight;
					if (window.scrollY < fondo - 2) return;

					objetivos.forEach(marcar);
					mirador.disconnect();
					removeEventListener('scroll', revelarRezagados);
				};

				const arrancar = () => {
					objetivos.forEach((el) => mirador.observe(el));
					addEventListener('scroll', revelarRezagados, { passive: true });
					// Por si la página entera cabe en la pantalla y no hay scroll que
					// llegue a disparar nada.
					revelarRezagados();
				};

				// La cortina tapa la pantalla y deja el contenido en `visibility:
				// hidden`, que sigue contando como visible para el observador. Sin
				// esperar, la primera pantalla se desvanecería a puerta cerrada y
				// aparecería ya entera.
				if (raiz.classList.contains('esta-cargando')) {
					document.addEventListener('intro:listo', arrancar, { once: true });
				} else {
					arrancar();
				}
			}
		</script>
	</body>
</html>
